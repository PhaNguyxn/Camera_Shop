a\\admin_shop\\src\\Users\\Users.jsx",[],"D:\\App_Camera\\admin_shop\\src\\Menu\\Menu.jsx",[],"D:\\App_Camera\\admin_shop\\src\\Categories\\Categories.jsx",[],"D:\\App_Camera\\admin_shop\\src\\Categories\\ViewCategories.jsx",["94"],"import React, { useEffect, useState } from \"react\";\r\n\r\nimport { useLocation } from \"react-router-dom\";\r\nimport ProductAPI from \"../API/ProductAPI\";\r\n\r\nfunction useQuery() {\r\n    const { search } = useLocation();\r\n    return React.useMemo(() => new URLSearchParams(search), [search]);\r\n}\r\n\r\nconst ViewCategories = () => {\r\n\r\n    const categoryId = useQuery().get('id');\r\n    const [category, setCategory] = useState({});\r\n\r\n    useEffect(() => {\r\n        if (categoryId) {\r\n            (async () => {\r\n                const res = await ProductAPI.getDetailCategory(categoryId);\r\n                if (res._id) {\r\n                    setCategory({...res});\r\n                }\r\n            })();\r\n        }\r\n    }, [categoryId])\r\n\r\n    const handleCreateCategory = async () => {\r\n        if (categoryId) {\r\n            const res = await ProductAPI.updateCategory(categoryId, category);\r\n            if (res?._id) {\r\n                window.location.href = '/categories';\r\n            }\r\n        } else if (!categoryId) {\r\n            const res = await ProductAPI.createCategory(category);\r\n            if (res?._id) {\r\n                setCategory({});\r\n            }\r\n        }\r\n    }\r\n\r\n    return (\r\n        <div className=\"page-wrapper\">\r\n            <div className=\"page-breadcrumb\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-7 align-self-center\">\r\n                        <h4 className=\"page-title text-truncate text-dark font-weight-medium mb-1\">Create Category</h4>\r\n                        <div className=\"d-flex align-items-center\">\r\n                            <nav aria-label=\"breadcrumb\">\r\n                                <ol className=\"breadcrumb m-0 p-0\">\r\n                                    <li className=\"breadcrumb-item\"><a href=\"/\" className=\"text-muted\">Home</a></li>\r\n                                    <li className=\"breadcrumb-item text-muted active\" aria-current=\"page\">Create</li>\r\n                                </ol>\r\n                            </nav>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"container-fluid\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12\">\r\n                        <div className=\"card\" style={{ paddingTop: '1.5rem' }}>\r\n                            <div style={{ margin: '0 1.5rem 1.5rem' }}>\r\n                                <h5 className=\"card-title\">Name Category</h5>\r\n                                <div className='d-flex justify-content-between'>\r\n                                    <input\r\n                                        onChange={(e) => setCategory({ ...category, ['category']: e.target.value })}\r\n                                        value={category?.category || ''}\r\n                                        className=\"form-control w-50\"\r\n                                        type=\"text\"\r\n                                        placeholder=\"Enter Name Category!\"\r\n                                    />\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"d-flex\" style={{ margin: '0 1.5rem 1.5rem' }}>\r\n                                <button\r\n                                    disabled={!category?.category}\r\n                                    onClick={handleCreateCategory}\r\n                                    style={{ cursor: 'pointer', color: 'white' }}\r\n                                    className='btn btn-success'>\r\n                                    {categoryId ? 'Update Category' : 'Create Category'}\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default ViewCategories;","D:\\App_Camera\\admin_shop\\src\\Products\\Component\\ViewEdit.jsx",[],"D:\\App_Camera\\admin_shop\\src\\Products\\Component\\Pagination.jsx",[],"D:\\App_Camera\\admin_shop\\src\\API\\UserAPI.jsx",[],"D:\\App_Camera\\admin_shop\\src\\API\\HistoryAPI.jsx",[],"D:\\App_Camera\\admin_shop\\src\\API\\ProductAPI.jsx",[],"D:\\App_Camera\\admin_shop\\src\\Products\\Component\\IndexPage.jsx",["95"],"import React from 'react';\r\nimport PropTypes from 'prop-types';\r\n\r\nIndexPage.propTypes = {\r\n    indexPage: PropTypes.array,\r\n    handlerChangePage: PropTypes.func,\r\n    pagination: PropTypes.object\r\n};\r\n\r\nIndexPage.defaultProps = {\r\n    indexPage: null,\r\n    handlerChangePage: null,\r\n    pagination: {}\r\n}\r\n\r\nfunction IndexPage(props) {\r\n\r\n    const { indexPage, handlerChangePage, pagination } = props\r\n\r\n    const { page } = pagination\r\n\r\n    const onIndexPage = (value) => {\r\n\r\n        if (!handlerChangePage){\r\n            return\r\n        }\r\n\r\n        handlerChangePage(value)\r\n\r\n    }\r\n\r\n    console.log(indexPage)\r\n\r\n    return (\r\n        <div className=\"d-flex\">\r\n            {\r\n                indexPage && indexPage.map(value => (\r\n                    <li className={value === parseInt(page) ? 'page-item active' : 'page-item'} \r\n                        key={value} \r\n                        onClick={() => onIndexPage(value)}>\r\n\r\n                        <a className=\"page-link\">{value}</a>\r\n\r\n                    </li>\r\n                ))\r\n            }\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default IndexPage;","D:\\App_Camera\\admin_shop\\src\\API\\axiosClient.jsx",[],"D:\\App_Camera\\admin_shop\\src\\History\\ViewHistory.jsx",[],"D:\\App_Camera\\admin_shop\\src\\Authentication\\Login.jsx",[],"D:\\App_Camera\\admin_shop\\src\\Authentication\\Register.jsx",[],{"ruleId":"96","replacedBy":"97"},{"ruleId":"98","replacedBy":"99"},{"ruleId":"100","severity":1,"message":"101","line":46,"column":11,"nodeType":"102","messageId":"103","endLine":46,"endColumn":21},{"ruleId":"100","severity":1,"message":"104","line":5,"column":10,"nodeType":"102","messageId":"103","endLine":5,"endColumn":14},{"ruleId":"105","severity":1,"message":"106","line":87,"column":8,"nodeType":"107","endLine":87,"endColumn":46,"suggestions":"108"},{"ruleId":"109","severity":1,"message":"110","line":66,"column":85,"nodeType":"111","messageId":"112","endLine":66,"endColumn":113,"fix":"113"},{"ruleId":"114","severity":1,"message":"115","line":42,"column":25,"nodeType":"116","endLine":42,"endColumn":50},"no-native-reassign",["117"],"no-negated-in-lhs",["118"],"no-unused-vars","'handleView' is assigned a value but never used.","Identifier","unusedVar","'Link' is defined but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'fetchAllData'. Either include it or remove the dependency array.","ArrayExpression",["119"],"no-useless-computed-key","Unnecessarily computed property ['category'] found.","Property","unnecessarilyComputedProperty",{"range":"120","text":"121"},"jsx-a11y/anchor-is-valid","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","JSXOpeningElement","no-global-assign","no-unsafe-negation",{"desc":"122","fix":"123"},[2694,2706],"'category'","Update the dependencies array to be: [pagination.page, pagination